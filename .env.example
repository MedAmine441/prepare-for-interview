# FrontMaster Environment Variables
# Copy this file to .env.local and fill in your values

# Kimi API Configuration (get a key at https://platform.moonshot.ai)
KIMI_API_KEY=your-kimi-api-key-here
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_MODEL=kimi-k2.6

# Optional: SQLite database path override (defaults to data/frontmaster.db).
# The test suite sets this to a throwaway file — you normally never need it.
# FRONTMASTER_DB_PATH=./data/frontmaster.db
